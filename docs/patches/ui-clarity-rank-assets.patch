+.eyebrow { font-size:11.5px; margin-bottom:6px; }
+.card { border-radius:15px; padding:26px; box-shadow:var(--shadow); }
+.card-heading { margin-bottom:20px; }
+.card-heading h2 { font-size:17px; }
