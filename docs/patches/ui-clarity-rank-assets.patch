+/* --------------------------------------------------------------------------
+   CenterPro clarity overhaul — consistent hierarchy, larger readable type,
+   quieter surfaces and parity across light/dark modes.
+   -------------------------------------------------------------------------- */
+:root {
+  --text:#292e37;
+  --muted:#646b76;
+  --border:#e2e4e8;
+  --surface:#ffffff;
+  --surface-soft:#f7f8fa;
+  --shadow:0 1px 3px #15181d0a;
+}
+body { font-size:14px; line-height:1.72; }
+h2 { font-size:19px; }
+h3 { font-size:16px; }
+small { font-size:12px; }
+.sidebar { width:244px; padding:28px 18px 22px; }
+.sidebar-brand .brand img { width:176px; }
+.nav-caption { font-size:11px; margin-bottom:11px; }
