+.icon-button { width:40px; height:40px; border-radius:9px; }
+.badge { min-height:28px; padding:4px 10px; border-radius:7px; font-size:11px; }
+.avatar { width:40px; height:40px; border-radius:11px; font-size:13px; }
+.avatar-sm { width:32px; height:32px; }
+.avatar-lg { width:60px; height:60px; }
+.form-grid { gap:20px; }
