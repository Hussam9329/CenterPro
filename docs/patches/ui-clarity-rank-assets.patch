+.grid-2 { gap:20px; }
+.grid-3 { gap:18px; }
+.stats-grid { gap:16px; }
+.stat-card { border-radius:13px; padding:21px 22px 20px; box-shadow:none; }
+.stat-top { font-size:12.5px; color:#636a75; }
