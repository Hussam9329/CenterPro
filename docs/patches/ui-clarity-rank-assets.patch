+/* Descriptive marketing/helper copy is intentionally omitted from ordinary page/card
+   headers. Critical warnings and confirmation descriptions remain visible. */
+.page-header > div > p,.card-heading p { display:none !important; }
+
+html[data-theme='dark'] {
+  --text:#e8eaee;
+  --muted:#aeb4bd;
+  --border:#30353d;
+  --canvas:#0f1115;
+  --background:#0f1115;
+  --surface:#171a1f;
+  --surface-soft:#1c2026;
+  --shadow:0 1px 3px #00000024;
+}
+html[data-theme='dark'] body { background:var(--canvas); color:var(--text); }
+html[data-theme='dark'] .sidebar,
+html[data-theme='dark'] .topbar,
+html[data-theme='dark'] .card,
+html[data-theme='dark'] .stat-card,
+html[data-theme='dark'] .quick-action,
+html[data-theme='dark'] .dialog-content,
+html[data-theme='dark'] .login-form-side { background:var(--surface); border-color:var(--border); }
+html[data-theme='dark'] .data-table th { background:#1e2228; color:#b7bdc6; border-color:#343941; }
+html[data-theme='dark'] .data-table td { color:#d6dae0; border-color:#292e35; }
+html[data-theme='dark'] .data-table td strong { color:#f0f2f4; }
+html[data-theme='dark'] .data-table tbody tr:hover td { background:#21191d; }
+html[data-theme='dark'] .field-label { color:#d0d4da; }
+html[data-theme='dark'] .stat-top { color:#b7bdc6; }
+html[data-theme='dark'] .stat-value { color:#f1f3f5; }
+html[data-theme='dark'] .empty-state h3 { color:#d8dbe0; }
+html[data-theme='dark'] .toast { background:#1c2026; border-color:#353b44; color:#eef0f2; box-shadow:0 14px 34px #0000003d; }
+
+@media (max-width: 1024px) {
+  .main-content { padding:28px 24px; }
+  .page-header h1 { font-size:27px; }
+  .card { padding:23px; }
+  .stat-value { font-size:29px; }
+}
+@media (max-width: 767px) {
+  body { font-size:14px; }
+  .main-content { padding:22px 16px calc(92px + env(safe-area-inset-bottom,0px)); }
+  .page-stack { gap:20px; }
+  .page-header { align-items:flex-start; gap:14px; }
+  .page-header h1 { font-size:25px; }
+  .card { padding:18px; border-radius:13px; }
+  .card-heading { margin-bottom:16px; }
+  .card-heading h2 { font-size:16px; }
+  .stats-grid { gap:10px; }
+  .stat-card { padding:17px; border-radius:11px; }
+  .stat-top { font-size:12px; }
+  .stat-value { font-size:25px; }
+  .btn,.button-link { min-height:44px; font-size:13px; }
+  .input { min-height:46px; font-size:14px; }
+  .mobile-cards { gap:11px; }
+  .mobile-cards .card { padding:16px; }
+  .toast { bottom:calc(78px + env(safe-area-inset-bottom,0px)); width:max-content; max-width:calc(100vw - 28px); font-size:12.5px; }
+}
+@media (max-width: 390px) {
+  .main-content { padding-inline:13px; }
+  .page-header h1 { font-size:23px; }
+  .card { padding:16px; }
+  .stat-card { padding:15px; }
+}
