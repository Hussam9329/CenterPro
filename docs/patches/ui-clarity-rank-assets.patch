+.input[type="date"],.input[type="month"],.input[type="time"] { min-height:46px; }
+.textarea { min-height:100px; }
+.filter-row { gap:10px; margin-bottom:20px; }
+.tabs button { min-height:47px; padding:12px 18px 14px; font-size:13px; }
+.table-wrap { border-radius:11px; }
