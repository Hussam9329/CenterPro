+        <path fill="var(--rank-secondary)" d="M699.86,118.94l-170.82,31.07c13.06-50,26.12-100.01,39.19-150.01h156.32c-8.23,39.65-16.46,79.3-24.68,118.94Z"/>
+      </svg>
