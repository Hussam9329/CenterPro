+export const AUTH_STORAGE_KEY = 'centerpro-local-auth-v1';
+const AUTH_SCHEMA_VERSION = 1;
+const PBKDF2_ITERATIONS = 150_000;
+const HASH_BYTES = 32;
+
+export interface StoredCredential {
+  salt: string;
+  hash: string;
+  version: number;
+  updatedAt: string;
+}
+
+export interface StoredSystemCredential extends StoredCredential {
+  username: string;
+}
+
+export interface AuthStore {
+  schema: number;
+  system: StoredSystemCredential | null;
+  employees: Record<string, StoredCredential>;
+}
+
+const emptyStore = (): AuthStore => ({ schema: AUTH_SCHEMA_VERSION, system: null, employees: {} });
+
+function storageAvailable() {
+  return typeof window !== 'undefined' && Boolean(window.localStorage) && Boolean(window.crypto?.subtle);
+}
+
+function bytesToBase64(bytes: Uint8Array) {
+  let binary = '';
+  for (const byte of bytes) binary += String.fromCharCode(byte);
+  return btoa(binary);
+}
+
+function base64ToBytes(value: string) {
+  const binary = atob(value);
+  return Uint8Array.from(binary, character => character.charCodeAt(0));
+}
+
+export function normalizeUsername(value: string) {
+  return value.trim().toLocaleLowerCase('en-US');
+}
+
+export function readAuthStore(): AuthStore {
+  if (!storageAvailable()) return emptyStore();
+  try {
+    const raw = window.localStorage.getItem(AUTH_STORAGE_KEY);
+    if (!raw) return emptyStore();
+    const parsed = JSON.parse(raw) as Partial<AuthStore>;
+    if (parsed.schema !== AUTH_SCHEMA_VERSION || typeof parsed.employees !== 'object' || parsed.employees === null) return emptyStore();
+    return {
+      schema: AUTH_SCHEMA_VERSION,
+      system: parsed.system && typeof parsed.system.username === 'string' && typeof parsed.system.salt === 'string' && typeof parsed.system.hash === 'string'
+        ? parsed.system as StoredSystemCredential
+        : null,
+      employees: parsed.employees as Record<string, StoredCredential>,
+    };
+  } catch {
+    return emptyStore();
+  }
+}
+
+export function writeAuthStore(store: AuthStore) {
+  if (!storageAvailable()) throw new Error('تعذر الوصول إلى التخزين الآمن للمتصفح.');
+  window.localStorage.setItem(AUTH_STORAGE_KEY, JSON.stringify(store));
+}
+
+async function derivePassword(password: string, salt: Uint8Array) {
+  const material = await window.crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveBits']);
+  const bits = await window.crypto.subtle.deriveBits(
+    { name: 'PBKDF2', hash: 'SHA-256', salt, iterations: PBKDF2_ITERATIONS },
+    material,
+    HASH_BYTES * 8,
+  );
+  return new Uint8Array(bits);
+}
+
+function equalBytes(left: Uint8Array, right: Uint8Array) {
+  if (left.length !== right.length) return false;
+  let difference = 0;
+  for (let index = 0; index < left.length; index += 1) difference |= left[index] ^ right[index];
+  return difference === 0;
+}
+
+export async function createCredential(password: string, previousVersion = 0): Promise<StoredCredential> {
+  if (!storageAvailable()) throw new Error('هذا المتصفح لا يدعم تشفير كلمات المرور المطلوب.');
+  const salt = window.crypto.getRandomValues(new Uint8Array(16));
+  const hash = await derivePassword(password, salt);
+  return {
+    salt: bytesToBase64(salt),
+    hash: bytesToBase64(hash),
+    version: Math.max(1, previousVersion + 1),
+    updatedAt: new Date().toISOString(),
+  };
+}
+
+export async function verifyCredential(password: string, credential: StoredCredential) {
+  try {
+    const salt = base64ToBytes(credential.salt);
+    const expected = base64ToBytes(credential.hash);
+    const actual = await derivePassword(password, salt);
+    return equalBytes(actual, expected);
+  } catch {
+    return false;
+  }
+}
+
+export async function configureSystemCredential(username: string, password: string) {
+  const store = readAuthStore();
+  const credential = await createCredential(password, store.system?.version ?? 0);
+  const system: StoredSystemCredential = { ...credential, username: username.trim() };
+  writeAuthStore({ ...store, system });
+  return system;
+}
+
+export async function setEmployeeCredential(employeeId: string, password: string) {
+  const store = readAuthStore();
+  const previous = store.employees[employeeId];
+  const credential = await createCredential(password, previous?.version ?? 0);
+  writeAuthStore({ ...store, employees: { ...store.employees, [employeeId]: credential } });
+  return credential;
+}
+
+export function removeEmployeeCredential(employeeId: string) {
+  const store = readAuthStore();
+  if (!store.employees[employeeId]) return;
+  const employees = { ...store.employees };
+  delete employees[employeeId];
+  writeAuthStore({ ...store, employees });
+}
+
+export function clearEmployeeCredentials() {
+  const store = readAuthStore();
+  writeAuthStore({ ...store, employees: {} });
+}
