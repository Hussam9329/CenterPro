+    expect(result('employee-jaafar-ali')).toMatchObject({ attendanceDays:17, excusedDays:0, unexcusedDays:0, requiredDays:17 });
+    expect(result('employee-maryam-fahad')).toMatchObject({ attendanceDays:4, excusedDays:2, unexcusedDays:0, requiredDays:6 });
+  });
+});
