+    const data = createTestData();
+    expect(data.employees.map(item => item.name)).toEqual(['ابرار حقي','هبة محمد','فاطمة فراس','مريم عصام','جعفر علي','مريم فهد']);
+    expect(data.evaluationCycles).toEqual([]);
+    expect(data.evaluationExams).toEqual([]);
+    expect(data.examEvaluations).toEqual([]);
+  });
+
+  it('matches the requested attendance scenarios', () => {
+    const data = createTestData();
+    const result = (id: string) => calculateEmployeePayroll(data, id, DEMO_MONTH);
+    expect(result('employee-abrar-haqi')).toMatchObject({ attendanceDays:16, excusedDays:0, unexcusedDays:0, requiredDays:16 });
+    expect(result('employee-hiba-mohammed')).toMatchObject({ attendanceDays:7, excusedDays:2, unexcusedDays:0, requiredDays:9 });
+    expect(result('employee-fatima-firas')).toMatchObject({ attendanceDays:16, excusedDays:1, unexcusedDays:1, requiredDays:18 });
