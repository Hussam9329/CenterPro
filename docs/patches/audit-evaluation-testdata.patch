+.multiButton { width:100%; min-height:43px; border:1px solid #dedfe5; border-radius:7px; background:#fff; color:#555a65; padding:9px 12px; display:flex; align-items:center; justify-content:space-between; gap:10px; text-align:right; }
+.multiPanel { position:absolute; z-index:30; inset-inline:0; top:calc(100% + 7px); background:#fff; border:1px solid #e1e2e6; border-radius:10px; box-shadow:0 16px 45px #20151a18; padding:12px; max-height:320px; overflow:auto; }
