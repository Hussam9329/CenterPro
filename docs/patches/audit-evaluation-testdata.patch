+import { describe, expect, it } from 'vitest';
+import { createTestData } from '../../src/lib/mock-data';
+import { calculateAccuracy, calculateEvaluationScore, getCycleLeaderboard, getExamLeaderboard } from '../../src/lib/evaluations';
+
+describe('correction evaluation domain', () => {
+  it('uses papers minus weighted correction and behavior errors only', () => {
+    expect(calculateEvaluationScore(800, 3, 2)).toBe(779);
+    expect(calculateEvaluationScore(0, 1, 1)).toBe(-8);
+  });
+
+  it('keeps accuracy informational and independent of weighted score', () => {
+    expect(calculateAccuracy(500, 3, 2)).toBe(99);
+    expect(calculateAccuracy(0, 0, 0)).toBeNull();
+  });
+
+  it('counts evaluated exams as an informational metric without multiplying the score', () => {
+    const data = createTestData();
+    data.evaluationCycles.push({ id:'cycle-1', name:'دورة التقييم 1', state:'OPEN', openedAt:'2026-10-01T00:00:00.000Z', openedBy:'مدير النظام' });
+    data.evaluationExams.push(
+      { id:'exam-1', cycleId:'cycle-1', name:'امتحان 1', date:'2026-10-01', note:'', state:'OPEN', createdBy:'مدير النظام', createdAt:'2026-10-01T00:00:00.000Z' },
+      { id:'exam-2', cycleId:'cycle-1', name:'امتحان 2', date:'2026-10-02', note:'', state:'OPEN', createdBy:'مدير النظام', createdAt:'2026-10-02T00:00:00.000Z' },
+    );
+    data.examEvaluations.push(
+      { id:'ev-1', examId:'exam-1', employeeId:'employee-abrar-haqi', papers:100, correctionErrors:1, behaviorErrors:0, note:'', createdBy:'جعفر علي', createdAt:'2026-10-01T10:00:00.000Z', updatedBy:'جعفر علي', updatedAt:'2026-10-01T10:00:00.000Z' },
+      { id:'ev-2', examId:'exam-2', employeeId:'employee-abrar-haqi', papers:100, correctionErrors:0, behaviorErrors:1, note:'', createdBy:'جعفر علي', createdAt:'2026-10-02T10:00:00.000Z', updatedBy:'جعفر علي', updatedAt:'2026-10-02T10:00:00.000Z' },
+    );
+    const row = getCycleLeaderboard(data, 'cycle-1').find(item => item.employeeId === 'employee-abrar-haqi')!;
+    expect(row).toMatchObject({ papers:200, correctionErrors:1, behaviorErrors:1, examsEvaluated:2, score:192 });
+  });
+
+  it('keeps all active correction employees on the exam leaderboard even with zero entries', () => {
+    const data = createTestData();
+    data.evaluationCycles.push({ id:'cycle-1', name:'دورة التقييم 1', state:'OPEN', openedAt:'2026-10-01T00:00:00.000Z', openedBy:'مدير النظام' });
+    data.evaluationExams.push({ id:'exam-1', cycleId:'cycle-1', name:'امتحان 1', date:'2026-10-01', note:'', state:'OPEN', createdBy:'مدير النظام', createdAt:'2026-10-01T00:00:00.000Z' });
+    const rows = getExamLeaderboard(data, 'exam-1');
+    expect(rows).toHaveLength(4);
+    expect(rows.every(row => row.score === 0 && row.examsEvaluated === 0)).toBe(true);
+  });
+});
