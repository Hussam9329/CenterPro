diff --git a/src/components/evaluations/auditor-workspace.tsx b/src/components/evaluations/auditor-workspace.tsx
new file mode 100644
index 0000000..b4c1d94
--- /dev/null
+++ b/src/components/evaluations/auditor-workspace.tsx
@@ -0,0 +1,130 @@
+'use client';
+
+import { useEffect, useMemo, useRef, useState, type ReactNode } from 'react';
+import { Check, ChevronDown, Minus, Plus, Search, UsersRound } from 'lucide-react';
+import { useDemo } from '@/components/demo-provider';
+import { Avatar, Badge, EmptyState, Input } from '@/components/ui';
+import { calculateEvaluationScore, getCorrectionEmployees, getExamEvaluation } from '@/lib/evaluations';
+import { date, time } from '@/lib/format';
+import styles from './evaluations.module.css';
+
+type NumericField = 'papers' | 'correctionErrors' | 'behaviorErrors';
+type SaveState = 'idle' | 'saving' | 'saved';
+
+function safeNumber(value: string): number | null {
+  if (value === '') return null;
+  const numeric = Number(value);
+  if (!Number.isSafeInteger(numeric) || numeric < 0) return null;
+  return numeric;
+}
+
+function valueText(value: number | null | undefined): string { return value === null || value === undefined ? '' : String(value); }
+
+function Stepper({ label, value, disabled, onImmediate, onType }: { label: string; value: string; disabled?: boolean; onImmediate: (value: number) => void; onType: (value: string) => void }) {
+  const numeric = safeNumber(value);
+  return <div className={styles.numericField}><span className={styles.numericLabel}>{label}</span><div className={styles.stepper}><button type="button" disabled={disabled || (numeric ?? 0) <= 0} onClick={() => onImmediate(Math.max(0, (numeric ?? 0) - 1))} aria-label={`إنقاص ${label}`}><Minus size={18}/></button><input inputMode="numeric" pattern="[0-9]*" value={value} placeholder="0" disabled={disabled} onChange={event => onType(event.target.value.replace(/\D/g, ''))} aria-label={label}/><button type="button" disabled={disabled} onClick={() => onImmediate((numeric ?? 0) + 1)} aria-label={`زيادة ${label}`}><Plus size={18}/></button></div></div>;
+}
+
+function EvaluationEditor({ examId, employeeId, disabled }: { examId: string; employeeId: string; disabled: boolean }) {
+  const { data, session, updateData } = useDemo();
+  const employee = data.employees.find(item => item.id === employeeId)!;
+  const current = getExamEvaluation(data, examId, employeeId);
+  const [papers, setPapers] = useState(valueText(current?.papers));
+  const [correctionErrors, setCorrectionErrors] = useState(valueText(current?.correctionErrors));
+  const [behaviorErrors, setBehaviorErrors] = useState(valueText(current?.behaviorErrors));
+  const [saveState, setSaveState] = useState<SaveState>('idle');
+  const timers = useRef<Record<NumericField, ReturnType<typeof setTimeout> | undefined>>({ papers: undefined, correctionErrors: undefined, behaviorErrors: undefined });
+
+  useEffect(() => {
+    setPapers(valueText(current?.papers));
+    setCorrectionErrors(valueText(current?.correctionErrors));
+    setBehaviorErrors(valueText(current?.behaviorErrors));
+  }, [current?.id, current?.papers, current?.correctionErrors, current?.behaviorErrors]);
+
+  useEffect(() => () => { Object.values(timers.current).forEach(timer => timer && clearTimeout(timer)); }, []);
+
+  function persist(field: NumericField, value: number | null) {
+    if (!session || disabled) return;
+    const before = getExamEvaluation(data, examId, employeeId);
+    setSaveState('saving');
+    updateData(draft => {
+      const index = draft.examEvaluations.findIndex(item => item.examId === examId && item.employeeId === employeeId);
+      const now = new Date().toISOString();
+      if (index >= 0) {
+        const target = draft.examEvaluations[index];
+        target[field] = value;
+        target.updatedBy = session.name;
+        target.updatedAt = now;
+        if (target.papers === null && target.correctionErrors === null && target.behaviorErrors === null && !target.note.trim()) draft.examEvaluations.splice(index, 1);
+      } else if (value !== null) {
+        draft.examEvaluations.push({ id: crypto.randomUUID(), examId, employeeId, papers: null, correctionErrors: null, behaviorErrors: null, note: '', [field]: value, createdBy: session.name, createdAt: now, updatedBy: session.name, updatedAt: now });
+      }
+    }, {
+      action: before ? 'تعديل بيانات تدقيق مصحح' : 'إضافة بيانات تدقيق مصحح',
+      entity: 'exam-evaluation',
+      entityId: before?.id ?? `${examId}:${employeeId}`,
+      employeeId,
+      oldValues: before ? { [field]: before[field] } : {},
+      newValues: { [field]: value, examId },
+    });
+    setSaveState('saved');
+    window.setTimeout(() => setSaveState('idle'), 1200);
+  }
+
+  function schedule(field: NumericField, raw: string) {
+    const setters = { papers: setPapers, correctionErrors: setCorrectionErrors, behaviorErrors: setBehaviorErrors };
+    setters[field](raw);
+    if (timers.current[field]) clearTimeout(timers.current[field]);
+    setSaveState('saving');
+    timers.current[field] = setTimeout(() => persist(field, safeNumber(raw)), 450);
+  }
+
+  function immediate(field: NumericField, value: number) {
+    if (timers.current[field]) clearTimeout(timers.current[field]);
+    const raw = String(value);
+    const setters = { papers: setPapers, correctionErrors: setCorrectionErrors, behaviorErrors: setBehaviorErrors };
+    setters[field](raw);
+    persist(field, value);
+  }
+
+  const score = calculateEvaluationScore(safeNumber(papers), safeNumber(correctionErrors), safeNumber(behaviorErrors));
+  const latest = getExamEvaluation(data, examId, employeeId);
+  return <article className={styles.auditCard}>
+    <div className={styles.auditCardHeader}><div className={styles.employeeIdentity}><Avatar name={employee.name}/><div><strong>{employee.name}</strong><small dir="ltr">{employee.code}</small></div></div>{latest ? <Badge tone="brand">لديه تقييم</Badge> : <Badge>لم يُدخل بعد</Badge>}</div>
+    <div className={styles.editorFields}>
+      <div className={styles.numericField}><span className={styles.numericLabel}>عدد الأوراق المصححة</span><Input type="text" inputMode="numeric" value={papers} placeholder="0" disabled={disabled} onChange={event => schedule('papers', event.target.value.replace(/\D/g, ''))}/></div>
+      <Stepper label="أخطاء التصحيح" value={correctionErrors} disabled={disabled} onImmediate={value => immediate('correctionErrors', value)} onType={value => schedule('correctionErrors', value)}/>
+      <Stepper label="أخطاء السلوك" value={behaviorErrors} disabled={disabled} onImmediate={value => immediate('behaviorErrors', value)} onType={value => schedule('behaviorErrors', value)}/>
+    </div>
+    <div className={styles.scoreStrip}><div><span className="muted">التقييم الحالي</span><strong dir="ltr">{score} نقطة</strong></div><span className={styles.saveState} data-state={saveState}>{saveState === 'saving' ? 'جارٍ الحفظ…' : saveState === 'saved' ? <><Check size={13}/>تم الحفظ</> : latest ? 'حفظ تلقائي' : 'أدخل القيم للبدء'}</span></div>
+    {latest && <div className={styles.metaLine}>آخر تحديث بواسطة {latest.updatedBy} · <span dir="ltr">{date(latest.updatedAt)} — {time(latest.updatedAt)}</span></div>}
+  </article>;
+}
+
+function MultiEmployeeFilter({ selected, onChange, employeeIds }: { selected: string[]; onChange: (ids: string[]) => void; employeeIds: { id: string; name: string }[] }) {
+  const [open, setOpen] = useState(false);
+  const selectedSet = new Set(selected);
+  return <div className={styles.multiSelect}><button className={styles.multiButton} type="button" onClick={() => setOpen(value => !value)} aria-expanded={open}><span className="inline"><UsersRound size={17}/>{selected.length === employeeIds.length ? 'كل المصححين' : `${selected.length} مصححين محددين`}</span><ChevronDown size={16}/></button>{open && <div className={styles.multiPanel}><div className={styles.multiActions}><button className="button-link" type="button" onClick={() => onChange(employeeIds.map(item => item.id))}>تحديد الكل</button><button className="button-link" type="button" onClick={() => onChange([])}>إلغاء التحديد</button></div>{employeeIds.map(item => <label className={styles.multiOption} key={item.id}><input type="checkbox" checked={selectedSet.has(item.id)} onChange={event => onChange(event.target.checked ? [...selected, item.id] : selected.filter(id => id !== item.id))}/><span>{item.name}</span></label>)}</div>}</div>;
+}
+
+export function AuditorWorkspace({ examId, examControl }: { examId: string; examControl?: ReactNode }) {
+  const { data } = useDemo();
+  const exam = data.evaluationExams.find(item => item.id === examId);
+  const employees = useMemo(() => getCorrectionEmployees(data), [data]);
+  const [selected, setSelected] = useState<string[]>(() => getCorrectionEmployees(data).map(item => item.id));
+  const [query, setQuery] = useState('');
+
+  const filtered = employees.filter(employee => selected.includes(employee.id) && employee.name.includes(query.trim()));
+  if (!exam) return <EmptyState title="الامتحان غير موجود" />;
+  if (!employees.length) return <EmptyState title="لا يوجد مصححون فعالون" description="أضف موظفين فعالين إلى قسم التصحيح أولاً." />;
+
+  return <div className="stack">
+    <div className={styles.toolbarGrid}>
+      {examControl ?? <div />}
+      <div className="field"><span className="field-label">اختيار المصححين</span><MultiEmployeeFilter selected={selected} onChange={setSelected} employeeIds={employees.map(item => ({ id:item.id, name:item.name }))}/></div>
+    </div>
+    <div className="filter-row" style={{ marginBottom: 0 }}><div className="search-input" style={{ maxWidth: 420 }}><Search size={18}/><Input value={query} onChange={event => setQuery(event.target.value)} placeholder="ابحث داخل المصححين المختارين"/></div></div>
+    {exam.state === 'CLOSED' && <div className="notice notice-warning">هذا الامتحان مغلق للتدقيق. يمكنك مشاهدة البيانات فقط حتى يعيد الأدمن فتحه.</div>}
+    {!selected.length ? <EmptyState title="لم تختر أي مصحح" description="اختر مصححاً واحداً أو أكثر لعرض حقول الإدخال." /> : !filtered.length ? <EmptyState title="لا توجد نتائج مطابقة" description="غيّر البحث أو اختيار المصححين." /> : <div className={styles.auditGrid}>{filtered.map(employee => <EvaluationEditor key={employee.id} examId={exam.id} employeeId={employee.id} disabled={exam.state === 'CLOSED'}/>)}</div>}
+  </div>;
+}
