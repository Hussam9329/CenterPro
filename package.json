{
  "name": "centerpro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "db:import": "node --import tsx scripts/db-import.ts",
    "test:e2e:remote": "playwright test --config playwright.remote.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-arabic": "^5.3.0",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@vercel/blob": "2.8.1",
    "@zxing/browser": "^0.2.1",
    "drizzle-orm": "0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
