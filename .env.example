# Server-only values. Never prefix database credentials with NEXT_PUBLIC_.
DATABASE_URL=
SESSION_SECRET=
APP_ORIGIN=https://centerpro-sigma.vercel.app
APP_TIMEZONE=Asia/Baghdad
BLOB_READ_WRITE_TOKEN=

# DATABASE_URL: pooled Neon PostgreSQL URL with TLS.
# SESSION_SECRET: at least 32 cryptographically random bytes; no default.
# BLOB_READ_WRITE_TOKEN: server-only token for the private employee-photo Blob store.
# Never use a public Blob store or NEXT_PUBLIC_ token for private personnel images.
# Vercel always uses server mode; missing config fails closed.
# Local development without DATABASE_URL retains the isolated UI regression mode.
# Migrate explicitly: npm run db:migrate
# Inspect a private backup: npm run db:import -- /absolute/backup.json --dry-run
# Import into an empty migrated DB only: npm run db:import -- /absolute/backup.json
